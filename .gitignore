__pycache__/
*.pyc
*.pyo
gurobi.log
*.ilp
infeasibility_report.ILP

# generated outputs (kept out of version control; folders tracked via .gitkeep)
output/*
!output/.gitkeep
figures/*
!figures/.gitkeep

# scenarios/: ignore everything auto-generated at runtime, but keep the
# formose stoichiometric data (not generated by any script; required input)
scenarios/*
!scenarios/.gitkeep
!scenarios/formose_minus.txt
!scenarios/formose_plus.txt

.DS_Store
