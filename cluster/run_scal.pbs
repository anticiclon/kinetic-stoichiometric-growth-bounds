#!/bin/bash
#PBS -N scalability
#PBS -q Parallel            # confirma el nombre con: qstat -q
#PBS -l nodes=1:ppn=8       # Gurobi aprovecha varios hilos por MILP
#PBS -l walltime=72:00:00   # confirma el máximo de la cola
#PBS -l mem=16gb
#PBS -t 0-7                 # 8 tareas = 8 tamaños (índices 0..7)
#PBS -j oe
#PBS -o logs/

cd "$PBS_O_WORKDIR"
mkdir -p output logs figures scenarios

module load python/3.12.8   # confirma el nombre exacto: module avail python
export GRB_LICENSE_FILE=$HOME/gurobi.lic   # ajusta a la ruta de tu licencia

# scalability_harness.py vive en src/; ejecutar desde la raíz del repo
python src/scalability_harness.py